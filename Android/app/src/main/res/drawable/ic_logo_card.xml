    <!-- Central connecting post -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 58,63 h 12 v 9 h -12 z" />

    <!-- Second horizontal bar -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 40.5,72 h 47 a 1.5,1.5 0 0 1 1.5,1.5 v 1 a 1.5,1.5 0 0 1 -1.5,1.5 h -47 a 1.5,1.5 0 0 1 -1.5,-1.5 v -1 a 1.5,1.5 0 0 1 1.5,-1.5 z" />

